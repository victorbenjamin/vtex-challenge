{
  "name": "catalog-consolidation",
  "version": "0.1.0",
  "private": true,
  "description": "Consolidates seller product feeds into a marketplace catalog without duplicating products.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx src/cli/db.ts",
    "db:reset": "tsx src/cli/db.ts --reset",
    "import": "tsx src/cli/import.ts",
    "catalog": "tsx src/cli/catalog.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
